# ============================================================================
# Biến môi trường của Seller Service
# ============================================================================
# Sao chép file này thành .env khi chạy local.
# Không commit .env, password, token hoặc API key thật lên Git.
# Khi chạy Docker Compose/Kubernetes, dùng hostname của service thay localhost.

# ----------------------------------------------------------------------------
# 01. Runtime - HTTP API và log TypeORM
# ----------------------------------------------------------------------------
NODE_ENV=development                         # development | production
PORT=3007                                     # Port HTTP của Seller Service
APP_VERSION=1.0.0                             # Version trả về trong health endpoint
TYPEORM_LOGGING=false                         # Bật log SQL khi cần debug

# ----------------------------------------------------------------------------
# 02. PostgreSQL - database riêng của Seller Service
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost                       # Host PostgreSQL khi chạy local
POSTGRES_PORT=5432                            # Port PostgreSQL
POSTGRES_USER=bin_ecommerce                   # User kết nối database
POSTGRES_PASSWORD=
POSTGRES_DB=bin_ecommerce_seller              # Tên database seller

# ----------------------------------------------------------------------------
# 03. Service nội bộ - xác thực và dữ liệu sản phẩm/danh mục
# ----------------------------------------------------------------------------
# Seller gọi Auth để kiểm tra activity và Product để kiểm tra product fact.
AUTH_SERVICE_URL=http://localhost:3002        # URL Auth Service khi chạy local
PRODUCT_SERVICE_URL=http://localhost:3008     # URL Product Service khi chạy local
CATALOG_SERVICE_URL=http://localhost:3003     # URL Catalog Service dùng validate onboarding
INTERNAL_SERVICE_TOKEN=

# ----------------------------------------------------------------------------
# 04. Seller Intelligence Copilot - server-side RAG and streaming chat
# ----------------------------------------------------------------------------
SELLER_COPILOT_ENABLED=true
SELLER_COPILOT_MODEL=gpt-4.1-mini
SELLER_COPILOT_TIMEOUT_MS=20000
SELLER_COPILOT_TOOL_TIMEOUT_MS=2500
SELLER_COPILOT_HISTORY_LIMIT=8
SELLER_COPILOT_RETENTION_DAYS=30
SELLER_KNOWLEDGE_DATASET_VERSION=seller-knowledge-v1
SELLER_POLICY_MIN_RELEVANCE_SCORE=0.55
SELLER_KNOWLEDGE_EMBEDDING_BATCH_SIZE=50
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_SELLER_KNOWLEDGE=seller_knowledge_v1
QDRANT_TIMEOUT_MS=3000

# ----------------------------------------------------------------------------
# 04. Kafka - thông báo seller application và shop profile event
# ----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092                # Danh sách broker, phân tách bằng dấu phẩy
KAFKA_CLIENT_ID=seller-service               # Định danh Kafka client
