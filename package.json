{
    "name": "@bin-ecommerce/seller-service",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "nest build && tsc-alias -p tsconfig.build.json",
        "start": "node --max-old-space-size=128 dist/services/seller-service/src/main.js",
        "dev": "nest start --watch",
        "knowledge:ingest": "node dist/services/seller-service/src/scripts/ingest-seller-knowledge.js",
        "knowledge:validate": "node dist/services/seller-service/src/scripts/ingest-seller-knowledge.js --dry-run",
        "question-planner:evaluate": "node dist/services/seller-service/src/scripts/evaluate-seller-question-planner.js",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "test": "jest --passWithNoTests"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.7",
        "@nestjs/axios": "^4.0.0",
        "@nestjs/config": "^4.0.1",
        "@nestjs/core": "^11.0.7",
        "@nestjs/platform-express": "^11.0.7",
        "@nestjs/swagger": "^11.1.0",
        "@nestjs/typeorm": "^11.0.0",
        "axios": "^1.12.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "helmet": "^8.1.0",
        "kafkajs": "^2.2.4",
        "pg": "^8.13.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^0.3.22"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.5",
        "@nestjs/testing": "^11.0.7",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.7",
        "@types/pg": "^8.11.10",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "tsc-alias": "^1.9.4",
        "typescript": "^5.7.3"
    }
}
